.bridge-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: space-between;
}

.viewport-frame {
    flex-grow: 1;
    border-width: 4px;
    border-color: rgba(0, 255, 255, 0.5);
    margin: 20px;
    background-color: rgba(0, 0, 0, 0);
}

.dashboard {
    height: 150px;
    background-color: rgb(30, 30, 30);
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

.sci-fi-button {
    background-color: rgb(45, 45, 45);
    color: rgb(0, 255, 255);
    border-width: 2px;
    border-color: rgb(0, 255, 255);
    border-radius: 10px;
    padding: 10px 20px;
    margin: 0 10px;
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.sci-fi-button:hover {
    background-color: rgb(0, 255, 255);
    color: rgb(30, 30, 30);
}

.status-bar {
    height: 50px;
    background-color: rgba(20, 20, 20, 0.8);
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
}

.status-text {
    color: white;
    margin-right: 20px;
}
