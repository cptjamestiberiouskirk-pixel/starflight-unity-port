:root {
    --space-950: rgba(5, 7, 13, 1);
    --space-900: rgba(10, 15, 28, 1);
    --space-800: rgba(17, 26, 46, 1);
    --space-700: rgba(26, 39, 66, 1);
    --space-600: rgba(36, 54, 90, 1);
    --space-400: rgba(74, 98, 144, 1);
    --space-200: rgba(159, 179, 217, 1);
    --ink-100: rgba(230, 240, 255, 1);
    --white: rgba(255, 255, 255, 1);
    --cyan-300: rgba(127, 243, 255, 1);
    --cyan-400: rgba(61, 230, 255, 1);
    --cyan-500: rgba(0, 200, 240, 1);
    --cyan-700: rgba(0, 122, 153, 1);
    --magenta-400: rgba(255, 79, 216, 1);
    --magenta-600: rgba(176, 23, 154, 1);
    --amber-400: rgba(255, 184, 77, 1);
    --amber-500: rgba(255, 154, 31, 1);
    --green-400: rgba(77, 255, 166, 1);
    --green-600: rgba(20, 184, 106, 1);
    --red-400: rgba(255, 90, 106, 1);
    --red-600: rgba(196, 30, 46, 1);
    --color-bg-app: var(--space-950);
    --color-bg-panel: var(--space-900);
    --color-bg-raised: var(--space-800);
    --color-bg-hover: var(--space-700);
    --color-border-subtle: var(--space-700);
    --color-border-default: var(--space-600);
    --color-border-accent: var(--cyan-400);
    --color-border-alert: var(--red-400);
    --color-text-primary: var(--ink-100);
    --color-text-secondary: var(--space-200);
    --color-text-muted: var(--space-400);
    --color-text-accent: var(--cyan-300);
    --color-text-on-accent: var(--space-950);
    --color-text-alert: var(--red-400);
    --color-text-warning: var(--amber-400);
    --color-accent-primary: var(--cyan-400);
    --color-accent-primary-strong: var(--cyan-500);
    --color-accent-primary-dim: var(--cyan-700);
    --color-accent-secondary: var(--amber-400);
    --color-status-shield: var(--cyan-400);
    --color-status-armor: var(--amber-400);
    --color-status-fuel: var(--green-400);
    --color-status-danger: var(--red-400);
    --spacing-2xs: 2px;
    --spacing-xs: 4px;
    --spacing-sm: 8px;
    --spacing-md: 12px;
    --spacing-lg: 16px;
    --spacing-xl: 24px;
    --spacing-2xl: 32px;
    --spacing-3xl: 48px;
    --radius-none: 0px;
    --radius-sm: 2px;
    --radius-md: 4px;
    --radius-lg: 8px;
    --radius-full: 999px;
}
